{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Library + CLI emit: ESM + declarations into dist/lib (dist/lib/rsl, dist/lib/cli).
       Source imports keep their .ts extensions (allowImportingTsExtensions); the emitted files get .js. */
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist/lib",
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/rsl", "src/cli"],
  "exclude": ["src/**/*.test.ts"]
}
